# dotenv-linter:off IncorrectDelimiter

# Do not commit your actual .env file to Git! This may contain secrets or other
# private information.

# Enable/disable step debug logging (default: `false`). For local debugging, it
# may be useful to set it to `true`.
ACTIONS_STEP_DEBUG=true

# GitHub Actions inputs should follow `INPUT_<name>` format (case-sensitive).
# Hyphens should not be converted to underscores!
# `npm run local-action` runs src/main.ts with these values against the
# repository in GITHUB_WORKSPACE (default: this checkout).
INPUT_PACKAGE=zod
INPUT_VERSION=4.1.5
INPUT_ATTEMPT-REPAIR=true
INPUT_COMMENT=false
INPUT_UPLOAD-ARTIFACT=false
INPUT_REPORT-DIR=depsherpa-report

# Model proposals are optional. Without a key DepSherpa still runs the isolated
# upgrade, the check comparison, and the deterministic repair recipes; it just
# records `agent_unavailable` for failures no recipe covers.
# INPUT_OPENAI-API-KEY=
# INPUT_OPENAI-BASE-URL=https://api.openai.com/v1
# INPUT_MODEL=gpt-4.1-mini

# The CLI reads the same settings from plain variables:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# DEPSHERPA_MODEL=
# DEPSHERPA_DEFAULT_OPENAI_BASE_URL=
# DEPSHERPA_DEFAULT_OPENAI_MODEL=

# GitHub Actions default environment variables. These are set for every run of a
# workflow and can be used in your actions. Setting the value here will override
# any value set by the local-action tool.
# https://docs.github.com/en/actions/learn-github-actions/variables#default-environment-variables

# GITHUB_WORKSPACE=""
# GITHUB_EVENT_NAME=""
# GITHUB_EVENT_PATH=""
# GITHUB_REPOSITORY=""
# GITHUB_RUN_ID=""
# GITHUB_SERVER_URL=""
# GITHUB_TOKEN=""
